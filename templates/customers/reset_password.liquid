<div class="section" style="--pt: 64px; --pb: 80px;">
  <div class="page-width" style="max-width: 520px;">
    <div class="section-header text-center"><h1>Choose a new password</h1></div>
    <div class="inked" style="padding: 1.8rem;">
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}<p class="form-status form-status--error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="field"><label class="field__label" for="ResetPassword">New password</label><input type="password" id="ResetPassword" name="customer[password]" required></div>
        <div class="field"><label class="field__label" for="ResetPasswordConfirm">Confirm password</label><input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" required></div>
        <button type="submit" class="button button--full">Save password</button>
      {%- endform -%}
    </div>
  </div>
</div>
