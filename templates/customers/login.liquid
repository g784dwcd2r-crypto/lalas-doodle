<div class="section" style="--pt: 64px; --pb: 80px;">
  <div class="page-width" style="max-width: 520px;">
    <div class="section-header text-center"><h1>Welcome back</h1></div>

    <div class="inked" style="padding: 1.8rem;">
      {%- form 'customer_login' -%}
        {%- if form.errors -%}
          <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="CustomerEmail">Email</label>
          <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
        </div>
        <div class="field">
          <label class="field__label" for="CustomerPassword">Password</label>
          <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
        </div>
        <button type="submit" class="button button--full">Sign in</button>
        <p style="text-align: center; margin-top: 1rem; font-size: 0.92rem;">
          <a href="#recover" onclick="document.getElementById('RecoverForm').hidden=false;return false;">Forgot your password?</a>
        </p>
      {%- endform -%}

      <div id="RecoverForm" hidden style="margin-top: 1.4rem; padding-top: 1.4rem; border-top: 2px dashed rgba(var(--green-deep-rgb), 0.3);">
        {%- form 'recover_customer_password' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success">We've sent you an email with a link to update your password.</p>
          {%- endif -%}
          <div class="field">
            <label class="field__label" for="RecoverEmail">Your email</label>
            <input type="email" id="RecoverEmail" name="email" required>
          </div>
          <button type="submit" class="button button--full button--outline">Send reset link</button>
        {%- endform -%}
      </div>
    </div>

    <p class="text-center" style="margin-top: 1.4rem;">
      New here? <a class="link-arrow" href="{{ routes.account_register_url }}">Create an account</a>
    </p>
  </div>
</div>
