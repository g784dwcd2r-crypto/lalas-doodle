        "max": 100,
        "step": 5,
        "unit": "%",
        "label": "Pattern strength",
        "default": 100
      },
      {
        "type": "range",
        "id": "pattern_size",
        "min": 80,
        "max": 600,
        "step": 20,
        "unit": "px",
        "label": "Pattern tile size",
        "default": 260
