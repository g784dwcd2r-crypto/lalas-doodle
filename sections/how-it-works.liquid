<div class="section scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-header text-{{ section.settings.text_align }} reveal">
        {%- if section.settings.subheading != blank -%}
          <span class="subheading">{{ section.settings.subheading }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte section-header__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid steps reveal"
      style="--cols-desktop: {{ section.settings.columns }}; --cols-tablet: 2; --cols-mobile: 1; margin-top: 3rem;">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          <span class="step__number"></span>
          {%- if block.settings.icon != blank -%}
            <div class="step__icon">{{ block.settings.icon }}</div>
          {%- endif -%}
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="text-center" style="margin-top: 2.6rem;">
        <a class="button button--large" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "How it works",
  "class": "steps-section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Small label", "default": "Easy as a belly rub" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How your portrait happens" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Four little steps between your favourite photo and a portrait you'll want on every wall.</p>" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading alignment",
      "options": [
        { "value": "center", "label": "Centre" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Start my portrait" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Section" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background colour",
      "options": [
        { "value": "page", "label": "Page background" },
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "pinksoft", "label": "Soft pink" },
        { "value": "pink", "label": "Bold pink" },
        { "value": "green", "label": "Bold green" }
      ],
      "default": "pinksoft"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji", "default": "📸" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Send me a photo" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Any photo where their little personality shines through. Phone snaps are perfect." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "icon": "📸", "heading": "Send me a photo", "text": "Pick a photo where their personality shines through. A phone snap is perfect — good light is all I ask." } },
        { "type": "step", "settings": { "icon": "🎨", "heading": "I start doodling", "text": "I draw every line by hand, matching their markings, their ears, that one wonky whisker you love." } },
        { "type": "step", "settings": { "icon": "💌", "heading": "You see a preview", "text": "I send a first look and tweak anything you'd like changed. It has to feel like them." } },
        { "type": "step", "settings": { "icon": "🖼", "heading": "Files in your inbox", "text": "High-resolution files land in your email, ready to print at any size you fancy." } }
      ]
    }
  ]
}
{% endschema %}
