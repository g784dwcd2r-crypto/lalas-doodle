<div class="section scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-header text-{{ section.settings.text_align }} reveal">
      {%- if section.settings.subheading != blank -%}<span class="subheading">{{ section.settings.subheading }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte section-header__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- assign blog = blogs[section.settings.blog] -%}
    {%- if blog.articles_count > 0 -%}
      <ul class="grid reveal" style="--cols-desktop: {{ section.settings.columns }}; --cols-tablet: 2; --cols-mobile: 1;">
        {%- for article in blog.articles limit: section.settings.limit -%}
          <li>{% render 'article-card', article: article, show_excerpt: section.settings.show_excerpt, show_date: section.settings.show_date, show_author: section.settings.show_author %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="text-center">Your blog posts will appear here once you've written some.</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="text-center" style="margin-top: 2.6rem;">
        <a class="button button--large" href="{{ blog.url | default: routes.root_url }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "class": "blog-posts-section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Small label", "default": "From the studio journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories, tips & pet art things" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Long reads about drawing animals, loving them, and keeping them close.</p>" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading alignment",
      "options": [{ "value": "center", "label": "Centre" }, { "value": "left", "label": "Left" }],
      "default": "center"
    },
    { "type": "blog", "id": "blog", "label": "Blog", "default": "news" },
    { "type": "range", "id": "limit", "min": 2, "max": 9, "step": 1, "label": "Posts to show", "default": 3 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 3 },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Read the journal" },
    { "type": "header", "content": "Section" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background colour",
      "options": [
        { "value": "page", "label": "Page background" },
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "pinksoft", "label": "Soft pink" },
        { "value": "pink", "label": "Bold pink" },
        { "value": "green", "label": "Bold green" }
      ],
      "default": "page"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
