<div class="section" style="--pt: 80px; --pb: 100px;">
  <div class="page-width">
    <div class="empty-state">
      <span class="emoji">🐕‍🦺</span>
      <h1>{{ section.settings.heading }}</h1>
      <div class="rte">{{ section.settings.text }}</div>
      <div style="display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; margin-top: 1.8rem;">
        <a class="button button--large" href="{{ routes.root_url }}">Back home</a>
        <a class="button button--large button--outline" href="{{ routes.all_products_collection_url }}">See the artwork</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page ran off with a sock" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We looked everywhere — under the sofa, behind the bins, in the good blanket. It isn't here. Let's get you back to the doodles.</p>" }
  ]
}
{% endschema %}
