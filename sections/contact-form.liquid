<div class="section scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="contact-grid reveal">
      <div>
        {%- if section.settings.subheading != blank -%}
          <span class="subheading" style="display: inline-block; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; font-size: 0.8rem; color: var(--pink); margin-bottom: 0.6rem;">{{ section.settings.subheading }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}

        {%- if settings.contact_email != blank -%}
          <p style="margin-top: 1.4rem; font-weight: 700;">
            <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
          </p>
        {%- endif -%}

        <div style="margin-top: 1.4rem;">{%- render 'social-icons' -%}</div>
      </div>

      <div>
        {%- form 'contact', class: 'inked', style: 'padding: 1.6rem;' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success">🐾 Thank you! Your message landed safely — I'll reply as soon as I can.</p>
          {%- elsif form.errors -%}
            <p class="form-status form-status--error">Something went wrong: {{ form.errors.messages.form | default: 'please check the fields below.' }}</p>
          {%- endif -%}

          <div class="field">
            <label class="field__label" for="ContactName">Your name</label>
            <input type="text" id="ContactName" name="contact[name]" required autocomplete="name">
          </div>
          <div class="field">
            <label class="field__label" for="ContactEmail">Email <span class="required">*</span></label>
            <input type="email" id="ContactEmail" name="contact[email]" required autocomplete="email">
          </div>
          <div class="field">
            <label class="field__label" for="ContactInstagram">Instagram username</label>
            <input type="text" id="ContactInstagram" name="contact[Instagram]" placeholder="@yourname" autocapitalize="off">
          </div>
          <div class="field">
            <label class="field__label" for="ContactPet">Your pet's name</label>
            <input type="text" id="ContactPet" name="contact[Pet name]">
          </div>
          <div class="field">
            <label class="field__label" for="ContactBody">Message <span class="required">*</span></label>
            <textarea id="ContactBody" name="contact[body]" required placeholder="Tell me about the portrait you're dreaming of..."></textarea>
          </div>
          <button type="submit" class="button button--full button--large">{{ section.settings.button_label }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Small label", "default": "Say hello" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let's talk about your pet" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions, special requests, or just want to show me a photo of your dog? Every message comes straight to me and I answer them all myself — usually within a day.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Send message" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background colour",
      "options": [
        { "value": "page", "label": "Page background" },
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "pinksoft", "label": "Soft pink" },
        { "value": "pink", "label": "Bold pink" },
        { "value": "green", "label": "Bold green" }
      ],
      "default": "page"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
