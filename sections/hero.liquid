<div class="section hero scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="hero__inner hero--image-{{ section.settings.image_position }} reveal">

      <div class="hero__text" style="text-align: {{ section.settings.text_align }};">
        {%- if section.settings.eyebrow != blank -%}
          <span class="pill hero__eyebrow">
            {% render 'icon-paw', class: 'logo-paw', color: 'currentColor' %}
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="hero__title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <div class="hero__subtitle rte" {% if section.settings.text_align == 'center' %}style="margin-inline: auto;"{% endif %}>
            {{ section.settings.subtitle }}
          </div>
        {%- endif -%}

        <div class="hero__buttons" {% if section.settings.text_align == 'center' %}style="justify-content: center;"{% endif %}>
          {%- if section.settings.button_label != blank -%}
            <a class="button button--large" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="button button--large button--outline" href="{{ section.settings.button_link_2 }}">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="hero__stats" {% if section.settings.text_align == 'center' %}style="justify-content: center;"{% endif %}>
            {%- for block in section.blocks -%}
              <div class="hero__stat" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.number }}</strong>
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="hero__media">
        <div class="media {% if section.settings.image_shape == 'blob' %}media--blob{% endif %} media--{{ section.settings.image_ratio }}">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1800 }} 1800w"
              sizes="(min-width: 990px) 46vw, 92vw"
              alt="{{ section.settings.image.alt | escape }}"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
              loading="eager"
              fetchpriority="high">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if section.settings.sticker_text != blank -%}
          <div class="hero__sticker hero__sticker--{{ section.settings.sticker_position }}">
            {{ section.settings.sticker_text }}
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "class": "hero-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "Custom digital pet portraits" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your best friend, drawn with a whole lot of love" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" },
        { "value": "h2", "label": "Medium" }
      ],
      "default": "h0"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Text",
      "default": "<p>Send me a photo and I'll turn your pet into a bold, bright, hand-drawn portrait — the kind that makes you smile every time you walk past it. Digital files, ready to print as big as your heart feels.</p>"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Main button", "default": "Order your portrait" },
    { "type": "url", "id": "button_link", "label": "Main button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button", "default": "See the gallery" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        { "value": "blob", "label": "Wobbly blob" },
        { "value": "rounded", "label": "Rounded rectangle" }
      ],
      "default": "blob"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "natural", "label": "Natural" }
      ],
      "default": "square"
    },
    { "type": "header", "content": "Sticker" },
    { "type": "text", "id": "sticker_text", "label": "Sticker text", "default": "From £35" },
    {
      "type": "select",
      "id": "sticker_position",
      "label": "Sticker position",
      "options": [
        { "value": "tr", "label": "Top right" },
        { "value": "bl", "label": "Bottom left" }
      ],
      "default": "tr"
    },
    { "type": "header", "content": "Section" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background colour",
      "options": [
        { "value": "page", "label": "Page background" },
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "pinksoft", "label": "Soft pink" },
        { "value": "pink", "label": "Bold pink" },
        { "value": "green", "label": "Bold green" }
      ],
      "default": "page"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Little stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "3-5" },
        { "type": "text", "id": "label", "label": "Label", "default": "happy pets drawn" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
