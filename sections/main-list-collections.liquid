<div class="section" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-header text-center reveal">
      <h1>{{ section.settings.heading | default: 'Collections' }}</h1>
    </div>
    <ul class="grid reveal" style="--cols-desktop: {{ section.settings.columns }}; --cols-tablet: 2; --cols-mobile: 1;">
      {%- for collection in collections -%}
        <li>
          <a href="{{ collection.url }}" style="text-decoration: none;">
            <div class="card lift">
              <div class="card__media media media--square" style="border-radius: 0;">
                {%- if collection.featured_image -%}
                  <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" loading="lazy">
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="card__body" style="text-align: center;">
                <h3 class="card__title">{{ collection.title }}</h3>
                <span style="font-size: 0.9rem; opacity: 0.8;">{{ collection.all_products_count }} items</span>
              </div>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 3 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ]
}
{% endschema %}
