<div class="section scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="{% if section.settings.full_width %}page-width page-width--wide{% else %}page-width{% endif %}">
    <div class="section-header text-{{ section.settings.text_align }} reveal">
      {%- if section.settings.subheading != blank -%}<span class="subheading">{{ section.settings.subheading }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte section-header__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="grid reveal" style="--cols-desktop: {{ section.settings.columns }}; --cols-tablet: 2; --cols-mobile: {{ section.settings.columns_mobile }};">
      {%- for block in section.blocks -%}
        {%- capture item -%}
          <div class="gallery-item media media--{{ section.settings.image_ratio }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                srcset="{{ block.settings.image | image_url: width: 450 }} 450w, {{ block.settings.image | image_url: width: 900 }} 900w"
                sizes="(min-width: 990px) 30vw, 92vw"
                alt="{{ block.settings.image.alt | default: block.settings.caption | escape }}"
                loading="lazy">
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <div class="gallery-item__caption">{{ block.settings.caption }}</div>
            {%- endif -%}
          </div>
        {%- endcapture -%}

        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" style="text-decoration: none; display: block;">{{ item }}</a>
        {%- else -%}
          {{ item }}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="text-center" style="margin-top: 2.6rem;">
        <a class="button button--large" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Art gallery",
  "class": "gallery-section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Small label", "default": "The doodle wall" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Some faces I've drawn lately" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every one of these belongs to somebody who loves them very much.</p>" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading alignment",
      "options": [{ "value": "center", "label": "Centre" }, { "value": "left", "label": "Left" }],
      "default": "center"
    },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 3 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Columns on mobile", "default": 2 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "natural", "label": "Natural" }
      ],
      "default": "square"
    },
    { "type": "checkbox", "id": "full_width", "label": "Use full page width", "default": false },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Section" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background colour",
      "options": [
        { "value": "page", "label": "Page background" },
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "pinksoft", "label": "Soft pink" },
        { "value": "pink", "label": "Bold pink" },
        { "value": "green", "label": "Bold green" }
      ],
      "default": "white"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "artwork",
      "name": "Artwork",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Bella, the world's bossiest spaniel" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Art gallery",
      "blocks": [
        { "type": "artwork" }, { "type": "artwork" }, { "type": "artwork" },
        { "type": "artwork" }, { "type": "artwork" }, { "type": "artwork" }
      ]
    }
  ]
}
{% endschema %}
