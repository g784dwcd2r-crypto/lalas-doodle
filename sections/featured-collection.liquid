<div class="section scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-header text-{{ section.settings.text_align }} reveal">
      {%- if section.settings.subheading != blank -%}<span class="subheading">{{ section.settings.subheading }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte section-header__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- assign products = section.settings.collection.products -%}
    {%- if products.size > 0 -%}
      <ul class="grid reveal" style="--cols-desktop: {{ section.settings.columns }}; --cols-tablet: 2; --cols-mobile: {{ section.settings.columns_mobile }};">
        {%- for product in products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product, show_badge: true %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul class="grid" style="--cols-desktop: {{ section.settings.columns }}; --cols-tablet: 2; --cols-mobile: {{ section.settings.columns_mobile }};">
        {%- for i in (1..section.settings.columns) -%}
          <li>
            <div class="card">
              <div class="card__media media media--square" style="border-radius: 0;">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
              <div class="card__body"><h3 class="card__title">Your lovely artwork</h3><div class="card__price">£35.00</div></div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="text-center" style="margin-top: 2.6rem;">
        <a class="button button--large" href="{{ section.settings.button_link | default: section.settings.collection.url }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured products",
  "class": "featured-collection-section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Small label", "default": "Pick your favourite" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Portraits, ready when you are" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Choose a style, tell me about your pet, and I'll get drawing.</p>" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading alignment",
      "options": [{ "value": "center", "label": "Centre" }, { "value": "left", "label": "Left" }],
      "default": "center"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 3 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 3 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Columns on mobile", "default": 1 },
    { "type": "text", "id": "button_label", "label": "Button", "default": "See everything" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Section" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background colour",
      "options": [
        { "value": "page", "label": "Page background" },
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "pinksoft", "label": "Soft pink" },
        { "value": "pink", "label": "Bold pink" },
        { "value": "green", "label": "Bold green" }
      ],
      "default": "page"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
