<footer class="footer section scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; border-top-width: {{ section.settings.border_width }}px;">

  <div class="page-width">
    <div class="footer__grid" style="--footer-cols: {{ section.blocks.size | minus: 1 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}

            {%- when 'brand' -%}
              <div style="margin-bottom: 1rem;">{%- render 'logo' -%}</div>
              {%- if block.settings.text != blank -%}
                <div class="rte" style="max-width: 38ch; font-size: 0.97rem;">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.show_social -%}
                <div style="margin-top: 1.2rem;">{%- render 'social-icons' -%}</div>
              {%- endif -%}

            {%- when 'menu' -%}
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>

            {%- when 'text' -%}
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              <div class="rte" style="font-size: 0.97rem;">{{ block.settings.text }}</div>

            {%- when 'newsletter' -%}
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              {%- if block.settings.text != blank -%}
                <p style="font-size: 0.97rem;">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- form 'customer', class: 'newsletter__form', style: 'margin: 0; max-width: none;' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="form-status form-status--success" style="width: 100%;">🐾 You're in! Watch your inbox for doodles.</p>
                {%- endif -%}
                <div class="field" style="margin: 0;">
                  <label class="visually-hidden" for="FooterEmail">Email</label>
                  <input id="FooterEmail" type="email" name="contact[email]" placeholder="your@email.com" required autocomplete="email">
                </div>
                <button type="submit" class="button button--small">Join</button>
              {%- endform -%}

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.copyright_extra != blank %} — {{ section.settings.copyright_extra }}{% endif %}
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="social-list" style="gap: 0.4rem;">
          {%- for type in shop.enabled_payment_types -%}
            <li style="list-style: none;">{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_policy_links -%}
        <ul class="footer__list" style="display: flex; gap: 1.2rem; flex-wrap: wrap;">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

<style>
  .footer .payment-icon { width: 38px; height: 24px; border-radius: 4px; }
</style>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background colour",
      "options": [
        { "value": "page", "label": "Page background" },
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "pinksoft", "label": "Soft pink" },
        { "value": "pink", "label": "Bold pink" },
        { "value": "green", "label": "Bold green" },
        { "value": "deep", "label": "Deep green" }
      ],
      "default": "pinksoft"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 12 },
    { "type": "range", "id": "border_width", "min": 0, "max": 8, "step": 1, "unit": "px", "label": "Top line thickness", "default": 3 },
    { "type": "header", "content": "Bottom row" },
    { "type": "text", "id": "copyright_extra", "label": "Extra copyright text", "default": "Every doodle drawn by hand, with love." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_policy_links", "label": "Show policy links", "default": true }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Logo & blurb",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Hand-drawn digital portraits of the animals who make our lives softer. Drawn in Lala's little studio, sent straight to your inbox.</p>"
        },
        { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Say hello" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about your portrait? Message me any time — I answer every single one myself.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Doodle post" },
        { "type": "text", "id": "text", "label": "Text", "default": "Little bits of pet art, studio news and the occasional discount." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu" },
        { "type": "text" },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
