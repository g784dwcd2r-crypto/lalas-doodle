<div class="section" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width {% if section.settings.narrow %}page-width--narrow{% endif %}">
    <div class="page-hero reveal">
      <h1>{{ page.title }}</h1>
    </div>
    <div class="rte reveal" style="margin-top: 2rem;">{{ page.content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "checkbox", "id": "narrow", "label": "Narrow column", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ]
}
{% endschema %}
