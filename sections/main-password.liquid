<div class="section" style="--pt: 80px; --pb: 80px; min-height: 100vh; display: grid; place-items: center;">
  <div class="page-width page-width--narrow text-center">
    <div style="margin-bottom: 1.6rem; display: flex; justify-content: center;">{%- render 'logo' -%}</div>

    <div class="inked" style="padding: 2.4rem 1.8rem;">
      <h1>{{ section.settings.heading }}</h1>
      <div class="rte" style="margin-bottom: 1.8rem;">{{ section.settings.text }}</div>

      {%- form 'storefront_password', class: 'newsletter__form' -%}
        {%- if form.errors -%}
          <p class="form-status form-status--error" style="width: 100%;">Wrong password — try again?</p>
        {%- endif -%}
        <div class="field" style="margin: 0;">
          <label class="visually-hidden" for="Password">Password</label>
          <input type="password" id="Password" name="password" placeholder="Password" autocomplete="current-password">
        </div>
        <button type="submit" class="button">Enter</button>
      {%- endform -%}
    </div>

    {%- if section.settings.show_newsletter -%}
      <div style="margin-top: 2.4rem;">
        <h2 class="h3">{{ section.settings.newsletter_heading }}</h2>
        {%- form 'customer', class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form-status form-status--success" style="width: 100%;">🐾 Thank you! I'll let you know the moment we open.</p>
          {%- endif -%}
          <div class="field" style="margin: 0;">
            <label class="visually-hidden" for="PasswordEmail">Email</label>
            <input type="email" id="PasswordEmail" name="contact[email]" placeholder="your@email.com" required>
          </div>
          <button type="submit" class="button">Notify me</button>
        {%- endform -%}
      </div>
    {%- endif -%}

    <p style="margin-top: 2rem; font-size: 0.9rem;">{{ powered_by_link }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something lovely is coming 🌷" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>thefurdoodle is nearly ready. Hand-drawn pet portraits, bright colours, a lot of love.</p>" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email sign-up", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Sign-up heading", "default": "Want to know when we open?" }
  ]
}
{% endschema %}
