<div class="section scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width {% if section.settings.narrow %}page-width--narrow{% endif %} text-{{ section.settings.text_align }} reveal">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'subheading' -%}
          <span class="subheading" style="display: inline-block; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; font-size: 0.8rem; color: var(--pink); margin-bottom: 0.6rem;" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- when 'heading' -%}
          <h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}
          <div class="rte" style="font-size: {{ block.settings.size }}rem;" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <div style="margin-top: 1.6rem;" {{ block.shopify_attributes }}>
            <a class="button button--large {% if block.settings.style == 'outline' %}button--outline{% endif %}" href="{{ block.settings.link }}">{{ block.settings.label }}</a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "class": "rich-text-section",
  "settings": [
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [{ "value": "center", "label": "Centre" }, { "value": "left", "label": "Left" }],
      "default": "center"
    },
    { "type": "checkbox", "id": "narrow", "label": "Narrow column", "default": true },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background colour",
      "options": [
        { "value": "page", "label": "Page background" },
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "pinksoft", "label": "Soft pink" },
        { "value": "pink", "label": "Bold pink" },
        { "value": "green", "label": "Bold green" },
        { "value": "deep", "label": "Deep green" }
      ],
      "default": "page"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    { "type": "subheading", "name": "Small label", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "A little note" }] },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "text", "label": "Heading", "default": "Something worth saying" },
        { "type": "select", "id": "size", "label": "Size", "options": [{ "value": "h1", "label": "Large" }, { "value": "h2", "label": "Medium" }, { "value": "h3", "label": "Small" }], "default": "h2" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Write anything you like here.</p>" },
        { "type": "range", "id": "size", "min": 0.9, "max": 1.6, "step": 0.1, "unit": "rem", "label": "Text size", "default": 1.1 }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Order a portrait" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" }
      ]
    }
  ],
  "presets": [
    { "name": "Rich text", "blocks": [{ "type": "subheading" }, { "type": "heading" }, { "type": "text" }, { "type": "button" }] }
  ]
}
{% endschema %}
