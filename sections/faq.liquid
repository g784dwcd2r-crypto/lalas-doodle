<div class="section scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width page-width--narrow">
    <div class="section-header text-center reveal">
      {%- if section.settings.subheading != blank -%}<span class="subheading">{{ section.settings.subheading }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte section-header__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="reveal">
      {%- for block in section.blocks -%}
        <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="text-center" style="margin-top: 2.2rem;">
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "class": "faq-section",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Small label", "default": "Curious things" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions people ask me" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>And if yours isn't here, just message me — I'd love to help.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Ask me anything" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Section" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background colour",
      "options": [
        { "value": "page", "label": "Page background" },
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "pinksoft", "label": "Soft pink" },
        { "value": "pink", "label": "Bold pink" },
        { "value": "green", "label": "Bold green" }
      ],
      "default": "cream"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does a portrait take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Usually 3-5 days from the moment I have your photo.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "What kind of photo should I send?", "answer": "<p>Anything clear and well lit where you can see their face properly — a phone photo is absolutely perfect. Daylight near a window is my favourite. Try to get down to their eye level if you can, and send two or three options if you're torn. If you only have one photo of them and it isn't perfect, send it anyway. I have worked from some very blurry, very precious pictures and I will always tell you honestly what I can do.</p>", "open": true } },
        { "type": "question", "settings": { "question": "How long will it take?", "answer": "<p>Most portraits are finished within 3-5 days. You'll get a preview before anything is final, and if something doesn't look quite like them, tell me — I'd much rather adjust it than have you nod politely at a drawing that isn't right.</p>" } },
        { "type": "question", "settings": { "question": "What exactly do I receive?", "answer": "<p>A high-resolution digital file, sent straight to your email. It's yours to print as many times as you like, at whatever size you fancy — a little desk frame, a big statement print for the hallway, a mug, a tote bag, a birthday card for the pet's other favourite human.</p>" } },
        { "type": "question", "settings": { "question": "Can you draw more than one pet together?", "answer": "<p>Yes, and it's one of my favourite things to do. The first pet is £35 and each extra pet is £7. They don't need to be in the same photo — send me one good picture of each and I'll bring them together as if they'd posed nicely all along, which they never do.</p>" } },
        { "type": "question", "settings": { "question": "With or without a background?", "answer": "<p>Both are lovely and both cost the same. Without a background, your pet floats on a clean colour — bold, graphic, very easy to frame. With a background, I add colour and shapes around them for something a bit more decorative. Not sure? Pick either and tell me in the notes; I'll advise honestly when I see your photo.</p>" } },
        { "type": "question", "settings": { "question": "Can I order a portrait of a pet who has passed away?", "answer": "<p>Of course, and please know I'll treat it with real care. Tell me their name and anything you'd like me to know about them. If the only photos you have are old or grainy, send them anyway and we'll talk it through gently. These portraits mean an enormous amount to me to make.</p>" } },
        { "type": "question", "settings": { "question": "Do you draw animals other than cats and dogs?", "answer": "<p>Always. Rabbits, horses, hamsters, guinea pigs, birds, reptiles, one very handsome cow. If you love them, I'll draw them.</p>" } },
        { "type": "question", "settings": { "question": "Can I use my portrait on Instagram?", "answer": "<p>Yes please, I'd love that! Use it as a profile picture, post it, print it, put it on a t-shirt for yourself. Personal use is all yours. If you'd like to use it commercially — for a business, a product you sell — just message me first and we'll sort it out.</p>" } }
      ]
    }
  ]
}
{% endschema %}
