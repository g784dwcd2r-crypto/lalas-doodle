{%- comment -%} Accepts: article, show_excerpt, show_date, show_author {%- endcomment -%}
<div class="card lift">
  <a href="{{ article.url }}" class="card__media media media--landscape" style="border-radius: 0; display: block;" tabindex="-1" aria-hidden="true">
    {%- if article.image -%}
      <img
        src="{{ article.image | image_url: width: 900 }}"
        srcset="{{ article.image | image_url: width: 450 }} 450w, {{ article.image | image_url: width: 900 }} 900w"
        sizes="(min-width: 990px) 400px, 92vw"
        alt="{{ article.image.alt | escape }}"
        loading="lazy">
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="card__body">
    <div class="article-card__meta">
      {%- if show_date != false -%}<span>{{ article.published_at | date: '%d %b %Y' }}</span>{%- endif -%}
      {%- if show_author and article.author != blank -%}<span>by {{ article.author }}</span>{%- endif -%}
    </div>
    <h3 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
    {%- if show_excerpt != false -%}
      <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
    {%- endif -%}
    <span class="link-arrow" style="margin-top: 0.6rem;">Read the story {% render 'icon-arrow' %}</span>
  </div>
</div>
