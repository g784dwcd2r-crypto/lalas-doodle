{%- comment -%} Accepts: color, flip, height {%- endcomment -%}
<div class="divider-wave" style="--wave-height: {{ height | default: 48 }}px;{% if flip %} transform: rotate(180deg);{% endif %}" aria-hidden="true">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
    <path d="M0 40 C 150 5, 250 5, 400 32 S 650 62, 800 32 S 1050 2, 1200 30 L1200 60 L0 60 Z" fill="{{ color | default: 'var(--pink)' }}"/>
  </svg>
</div>
